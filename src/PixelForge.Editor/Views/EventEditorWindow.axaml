<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PixelForge.Editor.ViewModels"
        x:Class="PixelForge.Editor.Views.EventEditorWindow"
        x:DataType="vm:EventEditorViewModel"
        Title="Event Editor"
        Width="1100"
        Height="720"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:EventEditorViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <DataTemplate x:Key="ShowMessageTemplate" x:DataType="vm:ShowMessageParametersViewModel">
            <StackPanel Spacing="6">
                <TextBlock Text="Message" />
                <TextBox Text="{Binding Text}"
                         AcceptsReturn="True"
                         Height="80" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ShowChoicesTemplate" x:DataType="vm:ShowChoicesParametersViewModel">
            <StackPanel Spacing="6">
                <TextBlock Text="Choices (one per line)" />
                <TextBox Text="{Binding ChoicesText}"
                         AcceptsReturn="True"
                         Height="80" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="InputNumberTemplate" x:DataType="vm:InputNumberParametersViewModel">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Variable ID" Width="90" VerticalAlignment="Center" />
                    <TextBox Text="{Binding VariableId}" Width="80" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Digits" Width="90" VerticalAlignment="Center" />
                    <TextBox Text="{Binding Digits}" Width="80" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="WaitTemplate" x:DataType="vm:WaitParametersViewModel">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Duration (frames)" Width="120" VerticalAlignment="Center" />
                    <TextBox Text="{Binding DurationFrames}" Width="80" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ScriptTemplate" x:DataType="vm:ScriptParametersViewModel">
            <StackPanel Spacing="6">
                <TextBlock Text="Script" />
                <TextBox Text="{Binding Script}"
                         AcceptsReturn="True"
                         Height="120" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="CustomTemplate" x:DataType="vm:CustomParametersViewModel">
            <StackPanel Spacing="6">
                <TextBlock Text="Parameters (JSON array)" />
                <TextBox Text="{Binding ParametersText}"
                         AcceptsReturn="True"
                         Height="80" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="#2D2D2D" Spacing="6" Margin="5">
            <Button Content="Add Event" Command="{Binding AddEventCommand}" />
            <Button Content="Remove Event" Command="{Binding RemoveEventCommand}" />
            <Separator />
            <Button Content="Add Page" Command="{Binding AddPageCommand}" />
            <Button Content="Remove Page" Command="{Binding RemovePageCommand}" />
            <Separator />
            <Button Content="Add Command" Command="{Binding AddCommandCommand}" />
            <Button Content="Remove Command" Command="{Binding RemoveCommandCommand}" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1E1E1E" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Events"
                               FontWeight="Bold"
                               Margin="0,0,0,8" />
                    <ListBox ItemsSource="{Binding Events}"
                             SelectedItem="{Binding SelectedEvent}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Background="#3E3E42" ResizeDirection="Columns" />

            <Grid Grid.Column="2" RowDefinitions="Auto,4,*" Background="#252526">
                <Border Grid.Row="0" Padding="10">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Event Details" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Name" Width="60" VerticalAlignment="Center" />
                            <TextBox Text="{Binding EventName}" Width="240" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Position" Width="60" VerticalAlignment="Center" />
                            <TextBox Text="{Binding PositionX}" Width="60" />
                            <TextBox Text="{Binding PositionY}" Width="60" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Note" />
                            <TextBox Text="{Binding EventNote}"
                                     AcceptsReturn="True"
                                     Height="60" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <GridSplitter Grid.Row="1" Background="#3E3E42" ResizeDirection="Rows" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#1E1E1E" Padding="8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Pages"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8" />
                            <ListBox ItemsSource="{Binding Pages}"
                                     SelectedItem="{Binding SelectedPage}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Trigger}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Margin="0,8,0,0" Spacing="6">
                                <TextBlock Text="Trigger" />
                                <ComboBox ItemsSource="{Binding TriggerOptions}"
                                          SelectedItem="{Binding SelectedPage.Trigger}" />
                                <TextBlock Text="Priority" />
                                <ComboBox ItemsSource="{Binding PriorityOptions}"
                                          SelectedItem="{Binding SelectedPage.Priority}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1" Background="#3E3E42" ResizeDirection="Columns" />

                    <Border Grid.Column="2" Background="#1E1E1E" Padding="8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Commands"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding Commands}"
                                      SelectedItem="{Binding SelectedCommand}"
                                      AutoGenerateColumns="False"
                                      GridLinesVisibility="Horizontal"
                                      Height="240"
                                      DockPanel.Dock="Top">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Command" Binding="{Binding CommandType}" Width="160" />
                                    <DataGridTextColumn Header="Indent" Binding="{Binding Indent}" Width="80" />
                                    <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Background="#252526" Padding="10" Margin="0,8,0,0">
                                <ContentControl Content="{Binding SelectedCommand}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate x:DataType="vm:EventCommandViewModel">
                                            <StackPanel Spacing="10">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="Command" Width="70" VerticalAlignment="Center" />
                                                    <ComboBox ItemsSource="{Binding CommandTypeOptions}"
                                                              SelectedItem="{Binding CommandType}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="Indent" Width="70" VerticalAlignment="Center" />
                                                    <TextBox Text="{Binding Indent}" Width="80" />
                                                </StackPanel>
                                                <StackPanel Spacing="6" IsVisible="{Binding IsCustom}">
                                                    <TextBlock Text="Code" />
                                                    <TextBox Text="{Binding Code}" Width="120" />
                                                </StackPanel>
                                                <ContentControl Content="{Binding ParametersViewModel}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
