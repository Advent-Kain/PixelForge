<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PixelForge.Editor.ViewModels"
             x:Class="PixelForge.Editor.Views.MapEditorView"
             x:DataType="vm:MapEditorViewModel">

    <Design.DataContext>
        <vm:MapEditorViewModel/>
    </Design.DataContext>

    <DockPanel>
        <!-- Toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="#2D2D2D" Spacing="5" Margin="5">
            <Button Content="New Map" Command="{Binding NewMapCommand}" />
            <Separator />
            <Button Content="+" Command="{Binding ZoomInCommand}" />
            <TextBlock Text="{Binding ZoomLevel, StringFormat='{}{0:P0}'}" VerticalAlignment="Center" Margin="5,0" />
            <Button Content="-" Command="{Binding ZoomOutCommand}" />
            <Separator />
            <ToggleButton Content="Grid" IsChecked="{Binding ShowGrid}" />
            <ToggleButton Content="Events" IsChecked="{Binding ShowEvents}" />
        </StackPanel>

        <!-- Tileset Panel -->
        <Border DockPanel.Dock="Left" Background="#2D2D2D" Padding="10" Width="260">
            <StackPanel Spacing="10">
                <TextBlock Text="Tilesets" FontWeight="Bold" />
                <ComboBox ItemsSource="{Binding Tilesets}"
                          SelectedItem="{Binding SelectedTileset}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Paint Tool" FontWeight="Bold" Margin="0,5,0,0" />
                <ComboBox ItemsSource="{Binding PaintTools}"
                          SelectedItem="{Binding SelectedTool}" />

                <TextBlock Text="Tile Palette" FontWeight="Bold" Margin="0,5,0,0" />
                <ListBox ItemsSource="{Binding TilePalette}"
                         SelectedItem="{Binding SelectedTileId}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="48" Height="48" Margin="2" Background="#1E1E1E" BorderBrush="#3A3A3A" BorderThickness="1">
                                <TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="White" />
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Layer Panel -->
        <Border DockPanel.Dock="Bottom" Background="#2D2D2D" Padding="5" Height="150">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Layers" FontWeight="Bold" Margin="0,0,0,5" />
                <StackPanel DockPanel.Dock="Right" Spacing="5" Margin="5,0,0,0">
                    <Button Content="+" Command="{Binding AddLayerCommand}" />
                    <Button Content="-" Command="{Binding RemoveLayerCommand}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Layers}"
                         SelectedItem="{Binding SelectedLayer}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <CheckBox IsChecked="{Binding Visible}" />
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Map Canvas -->
        <Border Background="#252526" ClipToBounds="True">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto">
                <Canvas Name="MapCanvas"
                        Width="960"
                        Height="720"
                        Background="#1A1A1A">
                    <!-- Map rendering will be done via custom control -->
                    <TextBlock Canvas.Left="10"
                             Canvas.Top="10"
                             Text="Map Editor Canvas"
                             Foreground="Gray"
                             FontSize="24" />
                    <TextBlock Canvas.Left="10"
                             Canvas.Top="40"
                             Text="(Custom map rendering control will be implemented here)"
                             Foreground="Gray" />
                </Canvas>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
