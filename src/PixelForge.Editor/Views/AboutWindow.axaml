<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PixelForge.Editor.Views.AboutWindow"
        Title="About PixelForge"
        Width="420"
        Height="260"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="PixelForge" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="RPG Game Engine &amp; Editor" FontSize="14" />
        <TextBlock Text="Built with Avalonia UI." FontSize="12" Foreground="Gray" />

        <StackPanel Margin="0,10,0,0">
            <TextBlock Text="Project Folder:" FontWeight="Bold" />
            <TextBlock Text="{Binding ProjectRoot}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Close" Click="CloseButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
